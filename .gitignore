# Dataset files - do not upload large image datasets to GitHub
dataset/raw/
dataset/processed/
*.jpg
*.jpeg
*.png

# ...but do bundle the app's own art (adventure scenes, icons, avatars) —
# the blanket rule above is meant for the ML dataset, not the Flutter app.
!frontend/assets/**/*.png

# Dataset pipeline - generated output, staging, and large raw source archives
dataset_v7/
_staging_v7/
*.zip

# ML training run outputs
ml/runs/

# AI model files - usually too large for GitHub
*.h5
*.keras
*.tflite
*.pt
*.pth

# System files
.DS_Store
Thumbs.db
*.cache
